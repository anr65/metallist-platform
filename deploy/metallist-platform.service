[Unit]
Description=Metallist platform
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=metallist
WorkingDirectory=/opt/metallist-platform/current
EnvironmentFile=/etc/metallist-platform/production.env
ExecStart=/opt/metallist-platform/current/platform
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/metallist-platform

[Install]
WantedBy=multi-user.target
